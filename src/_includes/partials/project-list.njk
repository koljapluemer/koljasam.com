<div class="grid {{ gridClass or 'is-col-min-20' }}">
  {%- for project in projectCollection -%}
  <div class="cell">
    <div class="card" style="height: 100%; display: flex; flex-direction: column;">
      <div class="card-image" style="display: flex; justify-content: center; align-items: center; min-height: 300px;">
        {{ projectImage(project.fileSlug) | safe }}
      </div>
      <div class="card-content" style="flex: 1;">
        <div class="content">
          {% if project.data.tags %}
          <div class="tags">
            {% for tag in project.data.tags %}
            <span class="tag">{{ tag }}</span>
            {% endfor %}
          </div>
          {% endif %}
          <h3 class="title is-4">{{ project.data.title | md | safe }}</h3>
          {% if project.data['main-link-href'] %}
          <a href="{{ project.data['main-link-href'] }}" class="button is-primary">
            {{ project.data['main-link-label'] or 'View Project' }}
          </a>
          {% endif %}
          {{ project.templateContent | safe }}
          {% if project.data.links %}
          <ul>
            {% for link in project.data.links %}
            {% if link.url and link.label %}
            <li>
              <a href="{{ link.url }}">{{ link.label }}</a>
            </li>
            {% endif %}
            {% endfor %}
          </ul>
          {% endif %}
        </div>
      </div>
      {% if project.data['footer-links'] %}
      <footer class="card-footer">
        {% for link in project.data['footer-links'] %}
        {% if link.url and link.label %}
        <a href="{{ link.url }}" class="card-footer-item">{{ link.label }}</a>
        {% endif %}
        {% endfor %}
      </footer>
      {% endif %}
    </div>
  </div>
  {%- endfor -%}
</div>
