    "@11ty/eleventy": "^3.1.2",
    "flowbite": "^2.5.1",
    "lucide": "^0.554.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.20",
