<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Milestones</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
  <main>
    <h1>Milestones</h1>

    <div class="cards-grid">
      {% for milestone in milestones %}
      {% set label = milestone.title or milestone.slug or milestone.id or ("Milestone " ~ loop.index) %}
      <article
        class="card{% if milestone.evaluation %} card-{{ milestone.evaluation | lower | replace(' ', '-') }}{% endif %}">
        <div class="card-main">
          <div class="card-content">
            {% if milestone.evaluation_html %}
            <span class="pill"><span class="label">Eval:</span> {{ milestone.evaluation_html | safe }}</span>
            {% endif %}
            {% if milestone.goal_html %}
            <div class="goal"><span class="label">Goal:</span> {{ milestone.goal_html | safe }}</div>
            {% endif %}

            <div class="meta">
              {% if milestone.started %}
              <span><span class="label">Start:</span> {{ milestone.started }}</span>
              {% endif %}
              {% if milestone.ended %}
              <span><span class="label">End:</span> {{ milestone.ended }}</span>
              {% endif %}
            </div>



            {% if milestone.showTheWorld_html %}
            <div class="show"><span class="label">Show:</span> {{ milestone.showTheWorld_html | safe }}</div>
            {% endif %}

            {% if milestone.comments_html %}
            <div class="label">Comments:</div>
            <ul class="comment-list">
              {% for comment in milestone.comments_html %}
              <li>{{ comment | safe }}</li>
              {% endfor %}
            </ul>
            {% endif %}

            {% if milestone.thumbnail %}
            <img class="milestone-thumbnail" src="{{ milestone.thumbnail }}" alt="">
            {% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </main>
</body>

<style>
  :root {
    --font-sans: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --text-1: #222;
    --text-2: #4b4b4b;
    --border-1: #222;
    --border-2: #0000001f;
    --card-bg: #fff;
    --max-page-width: 100ch;
    --radius-1: 0.5rem;
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --fs-body: clamp(1rem, 0.97rem + 0.15vw, 1.0625rem);
    --fs-title: clamp(1.1rem, 1.02rem + 0.5vw, 1.35rem);
    --fs-link: 0.875rem;
    --lh-body: 1.6;
    --lh-title: 1.3;
  }

  html {
    font-size: 100%;
  }

  body {
    max-width: var(--max-page-width);
    margin-inline: auto;
    padding: calc(1vmin + var(--space-2));
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--text-1);
    line-height: var(--lh-body);
  }

  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h1 {
    margin: 0;
    line-height: 1.15;
  }

  p {
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: minmax(11.25rem, auto);
    grid-auto-flow: row dense;
    gap: var(--space-4);
  }

  .card {
    border: 1px solid var(--border-1);
    border-radius: var(--radius-1);
    background: var(--card-bg);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .card-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    width: 100%;
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .card-title {
    margin: 0;
    line-height: var(--lh-title);
    font-size: var(--fs-title);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .pill {
    border: 1px solid var(--border-1);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    font-size: var(--fs-link);
    line-height: 1.4;
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--text-2);
    font-size: var(--fs-link);
  }

  .goal,
  .show {
    color: var(--text-1);
  }

  .goal {
    font-weight: bold;

  }

  .comment-list {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .milestone-thumbnail {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-1) - 0.125rem);
    object-fit: contain;
    object-position: center;
    margin-top: var(--space-2);
  }

  .label {
    color: var(--text-2);
    font-size: var(--fs-link);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 56.25rem) {
    .cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 37.5rem) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

</html>
