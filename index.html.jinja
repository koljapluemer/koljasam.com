<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kolja Sam's Website</title>
  <script data-goatcounter="https://koljapluemer.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
  <header>
    <h1>Kolja Sam Pluemer</h1>
  </header>

  <main>
    <p>My mission is to make the world a better place by building excellent tools for learning.</p>

    <section>
      <h2>Contact</h2>
      <ul>
        <li><b>Get in touch at <em>contact (at) koljasam.com</em>.</b></li>
        <li><a href="https://github.com/koljapluemer" target="_blank">GitHub</a></li>
      </ul>
    </section>

    <section>
      <h2>Cards</h2>
      <div class="cards-grid">
        {% for card in cards %}
        <article class="card{% if card.image_left %} card-horizontal{% endif %}"
          style="--cols: {{ card.cols }}; --rows: {{ card.rows }};">
          {% if card.thumbnail %}
          <img src="{{ card.thumbnail }}" alt="">
          {% endif %}

          <div class="card-content">
            <div class="badge">{{ card.type }}</div>
            {% if card.url %}
            <h3><a href="{{ card.url }}" target="_blank">{{ card.title }}</a></h3>
            {% else %}
            <h3>{{ card.title }}</h3>
            {% endif %}
            {% if card.description %}
            <small>{{ card.description }}</small>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </section>
  </main>
</body>

<style>
  html {
    max-width: 100ch;
    padding: calc(1vmin + 0.5rem);
    margin-inline: auto;
    font-family: system-ui;
    color: #222;
  }

  a {
    color: #222;
  }

  body :not(:is(h1, h2, h3, h4, h5, h6)) {
    line-height: 1.6;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(180px, auto);
    grid-auto-flow: row dense;
    gap: 16px;
  }

  .card {
    border: 1px #222 solid;
    border-radius: 8px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    grid-column: span var(--cols, 1);
    grid-row: span var(--rows, 1);
  }

  .card img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    object-fit: cover;
  }

  .card-horizontal {
    flex-direction: row;
    align-items: flex-start;
  }

  .card-horizontal img {
    width: 36%;
    max-width: 240px;
    align-self: stretch;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  h3 {
    margin: 0;
    line-height: 1.3;
    font-size: 14pt;
  }

  .badge {
    width: fit-content;
    padding: 2px 6px;
    border-radius: 4px;
    background-color: #e6e6e6;
    text-transform:uppercase;
    font-size: 7pt;
    color: #4b4b4b;
    font-family: monospace;
  }

  @media (max-width: 900px) {
    .cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }

    .card {
      grid-column: span 1;
      grid-row: span 1;
      flex-direction: column;
    }

    .card-horizontal img {
      width: 100%;
      max-width: none;
    }
  }
</style>

</html>
