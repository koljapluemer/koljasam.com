<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kolja Sam's Website</title>
  <script>
    window.goatcounter = {
      path: function (p) { return location.host + p }
    }
  </script>
  <script data-goatcounter="https://koljapluemer.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
</head>

<body>
  <main>
    <h1>Kolja Sam Pluemer</h1>

    <p>My mission is to make the world a better place by building excellent tools for learning. <br /> Get in touch at
      <em>contact (at) koljasam.com</em>.
    </p>

    <div class="cards-grid">
      {% for card in cards %}
      <article
        class="card{% if card.image_left %} card-horizontal{% endif %}{% if card.paused %} card-paused{% endif %}"
        style="--cols: {{ card.cols }}; --rows: {{ card.rows }};">
        <div class="card-main">
          {% if card.thumbnail %}
          <img class="card-thumbnail" src="{{ card.thumbnail }}" alt="">
          {% endif %}

          <div class="card-content">
            <h3 class="card-title">
              {% if card.url %}
              <a href="{{ card.url }}" target="_blank">{{ card.title }}</a>
              {% else %}
              <span>{{ card.title }}</span>
              {% endif %}
            </h3>
            {% if card.description %}
            <small>{{ card.description }}</small>
            {% endif %}
          </div>
        </div>
        {% if card.links %}
        <div class="card-links">
          {% for link in card.links %}
          <a href="{{ link.url }}" target="_blank">{{ link.label }}</a>
          {% endfor %}
        </div>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </main>
</body>

<style>
  :root {
    --font-sans: "Inter", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    --text-1: #222;
    --text-2: #4b4b4b;
    --border-1: #222;
    --border-2: #0000001f;
    --card-bg: #fff;
    --max-page-width: 100ch;
    --radius-1: 0.5rem;
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.5rem;
    --fs-body: clamp(1rem, 0.97rem + 0.15vw, 1.0625rem);
    --fs-title: clamp(1.1rem, 1.02rem + 0.5vw, 1.35rem);
    --fs-link: 0.875rem;
    --lh-body: 1.6;
    --lh-title: 1.3;
  }

  html {
    font-size: 100%;
  }

  body {
    max-width: var(--max-page-width);
    margin-inline: auto;
    padding: calc(1vmin + var(--space-2));
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--text-1);
    line-height: var(--lh-body);
  }

  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h1 {
    margin: 0;
    line-height: 1.15;
  }

  p {
    margin: 0;
  }

  .card-title {
    margin: 0;
    line-height: var(--lh-title);
    font-size: var(--fs-title);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  a {
    color: var(--text-1);
    text-decoration-style: dotted;
    text-decoration-color: var(--text-2);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(11.25rem, auto);
    grid-auto-flow: row dense;
    gap: var(--space-4);
  }

  .card {
    border: 1px solid var(--border-1);
    border-radius: var(--radius-1);
    background: var(--card-bg);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    grid-column: span var(--cols, 1);
    grid-row: span var(--rows, 1);
  }

  .card-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .card-thumbnail {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-1) - 0.125rem);
    object-fit: contain;
    object-position: center;
  }

  .card-horizontal {
    align-items: stretch;
  }

  .card-horizontal .card-main {
    flex-direction: row;
    align-items: flex-start;
  }

  .card-horizontal .card-main>.card-thumbnail {
    flex: 0 0 36%;
    width: 36%;
    max-width: 15rem;
    align-self: flex-start;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    width: 100%;
  }

  .card-title a,
  .card-title span {
    min-width: 0;
  }

  .card-links {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card-links a {
    display: inline-block;
    font-size: var(--fs-link);
  }

  @media (max-width: 56.25rem) {
    .cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 37.5rem) {
    .cards-grid {
      grid-template-columns: 1fr;
    }

    .card {
      grid-column: span 1;
      grid-row: span 1;
      flex-direction: column;
    }

    .card-horizontal .card-main {
      flex-direction: column;
    }

    .card-horizontal .card-main>.card-thumbnail {
      width: 100%;
      flex: 0 0 auto;
      max-width: none;
    }
  }
</style>

</html>